.pio/
*.exe
*.dll

/hardware/pcb/gerbers
.claude/
/design/plantuml.jar

# Local secrets — never commit
.github/token.local
*.local

# 2.0.0-alpha.3.1 was a throwaway dev build that baked WiFi credentials
# (ssid + psk literals) into the source temporarily for one-shot NVS
# seeding on the bench LOLIN S3. The literals were stripped from source
# in alpha.3.2 but the .bin / .elf / .map produced by alpha.3.1 still
# contain the plaintext PSK and will leak it if uploaded anywhere. Keep
# the directory off GitHub. The changelog entry for alpha.3.1 carries
# the historical context; binaries belong nowhere but the original
# developer's disk.
/bin/2.0.0-alpha.3.1/

# Python caches
__pycache__/
*.py[cod]

# Editor / IDE state
.vscode/
.idea/

# Untracked working dumps (currently in Archive/) — phone-camera shots
# accidentally committed in b89fac0 totalled ~25 MB.  Block further drift:
/Archive/images/IMG_*.jpg
/Archive/images/IMG_*.JPG
/Archive/images/IMG_*.png
/finance/RECEIPT_*.pdf
/model/simulation.zip

# Generated PDF/HTML siblings of manual sources — produced by md2pdf.py
/manual/*.html
debug/
/.tmp

# ESP-IDF build-system artefacts (appearing from 2.0.0-alpha.1 onwards when
# framework = espidf replaces framework = arduino). PlatformIO+espidf still
# writes most of its build output under .pio/ (already ignored above), but
# native idf.py paths, managed-component caches, and per-env auto-generated
# sdkconfig files land outside it.
#
# Tracked: firmware/sdkconfig.defaults  (load-bearing project config, source-of-truth)
# Ignored: firmware/sdkconfig            (auto-generated, copy of defaults + diffs)
# Ignored: firmware/sdkconfig.old        (auto-generated backup)
# Ignored: firmware/sdkconfig.<env>      (auto-generated per-PlatformIO-environment)
/firmware/build/
/firmware/sdkconfig
/firmware/sdkconfig.old
/firmware/sdkconfig.lolin_s3
/firmware/sdkconfig.test_t2_relay
/firmware/managed_components/
/firmware/dependencies.lock
