#!/usr/bin/env bash
# .githooks/pre-commit — guards against committing build-time artefacts and
# against the config-key tables drifting apart.
#
# Two rules, each checked only when the commit actually touches the relevant
# files:
#
#   1. firmware/data/manifest.json — must be staged in placeholder form,
#       i.e. exactly  {"asset_version":"{{ASSET_VERSION}}","checksum":""}
#       (no trailing newline). The build script `bin/build_release.ps1`
#       overwrites this file with the literal version on every release
#       build, so the placeholder discipline survives only if commits
#       restore the placeholder. See gh#9.
#
#   2. the config key descriptor — a key is declared once, in
#       firmware/config/cfg_desc.inc, and `bin/check_cfg_desc.py` verifies it.
#       Six independent tables used to carry the key list (accepted / shadow
#       field / clamped / audited / published / mock) and they drifted every
#       time: gh#53, gh#57 part 1 and part 2, gh#51 Group D all SHIPPED.
#       gh#64 collapsed them. The residual risk moved: the shadow write is
#       offsetof-driven, so a wrong field name writes the wrong setting and
#       compiles cleanly — which is mostly what this check now guards.
#
# To enable:    git config core.hooksPath .githooks       (one-time, per clone)
# To bypass:    git commit --no-verify  (do not use casually; see below)

set -euo pipefail

staged_files=$(git diff --cached --name-only)

# ---------------------------------------------------------------------------
# Rule 1 — asset manifest placeholder (gh#9)
# ---------------------------------------------------------------------------
placeholder='{"asset_version":"{{ASSET_VERSION}}","checksum":""}'
manifest='firmware/data/manifest.json'

if printf '%s\n' "$staged_files" | grep -qx "$manifest"; then
    # Read the staged content (':<path>' addresses the index, not the working tree).
    staged=$(git show ":$manifest")

    if [ "$staged" != "$placeholder" ]; then
        cat >&2 <<EOF
x pre-commit: $manifest is staged in stamped form, not the placeholder.

  staged:      $staged
  expected:    $placeholder

  This usually means \`bin/build_release.ps1\` rewrote it for a release
  build and the result was accidentally re-staged. The release artefacts
  in bin/<version>/ already capture the literal-version manifest; the
  in-tree file should stay as the placeholder.

  Fix:
    git restore --staged $manifest          # un-stage
    git checkout $manifest                  # restore from HEAD (placeholder)
    git add <other-files-you-meant-to-commit>
    git commit ...

  Override (use sparingly, only when intentionally bumping the baseline):
    git commit --no-verify

  Background: gh#9
EOF
        exit 1
    fi
fi

# ---------------------------------------------------------------------------
# Rule 2 — config-key table consistency (gh#64)
# ---------------------------------------------------------------------------
if printf '%s\n' "$staged_files" | grep -qE \
      '^(firmware/config/cfg_desc\.inc|firmware/src/data_manager/data_manager\.(cpp|h)|firmware/src/web_server/web_server\.cpp|firmware/config/cfg_limits\.h|webUiMock/mock_server\.py|bin/check_cfg_(desc|tables)\.py)$'; then

    py=""
    for cand in python python3 py; do
        if command -v "$cand" >/dev/null 2>&1; then py="$cand"; break; fi
    done

    if [ -z "$py" ]; then
        # An unrunnable check must not look like a pass, so say so loudly
        # rather than exiting quietly. Not fatal: a missing interpreter is an
        # environment problem, not a defect in the commit.
        cat >&2 <<'EOF'
! pre-commit: SKIPPED the config-key table check — no python interpreter found.
  This commit touches the config key table and was NOT verified. Run
  `python bin/check_cfg_desc.py` wherever python is available before pushing.
  Background: gh#64
EOF
    elif ! "$py" bin/check_cfg_desc.py; then
        cat >&2 <<EOF

x pre-commit: the config key descriptor does not check out (see above).

  Since gh#64 a config key is declared ONCE, in firmware/config/cfg_desc.inc,
  and the clamp, the shadow write, the audit id and GET /api/config/limits all
  read it. Adding a key is one row; there is no second table to keep in step.

  What this check is really guarding is the price of that collapse: the shadow
  write is driven by offsetof(), so naming the WRONG FIELD compiles, runs, and
  quietly writes a real but different setting. Nothing downstream would notice.
  If it is complaining about a shadow field, believe it.

  It also fails when webUiMock/mock_server.py drifts from the firmware — that
  is the one copy of the limits still living outside the table — and when a
  consumer starts growing its own key list again, which is how all six tables
  drifted the first time.

  Override (only with a reason you would defend in review):
    git commit --no-verify

  Background: gh#64
EOF
        exit 1
    fi
fi

exit 0
