# bin/.rota_release.env  --  config for bin/rota_release.py
#
# Copy this file to  bin/.rota_release.env  (git-ignored) and fill in.
# NO secrets belong here: connection details only. The per-unit ota_secrets
# and the server key live in the operator's secret store / on the VPS, never
# in this repo (R-T07).

# SSH target for the FOTA-server VPS. Prefer an ~/.ssh/config alias so the
# hostname, user, IdentityFile and pinned host key live there (R-T07). e.g.:
#   Host ota-vps
#     HostName <vps-host>
#     User <deploy-user>
#     IdentityFile ~/.ssh/<key>
#     IdentitiesOnly yes
ROTA_SSH=ota-vps

# Absolute path of ota-store/ on the VPS (outside the webroot; see the FOTA
# server repo tools/bootstrap.md). Default if unset: /var/www/ota-store
ROTA_STORE=/var/www/ota-store

# unit_type key used in channels/*.json and the manifest. Default: ghc1
ROTA_UNIT_TYPE=ghc1

# Anti-downgrade floor written into new manifests when --min-version is not
# given and none can be carried forward. Default: 2.1.0
ROTA_MIN_VERSION=2.1.0

# Optional: base URL + pinned server cert PEM, used only to print a
# ready-to-run bin/rota_sim.py verification command after a publish.
ROTA_BASE_URL=https://ota.rfsee.net
ROTA_CERT=
