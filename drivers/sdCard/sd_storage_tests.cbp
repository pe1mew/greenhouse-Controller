<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
    <FileVersion major="1" minor="6" />
    <Project>
        <Option title="sd_storage_tests" />
        <Option pch_mode="2" />
        <Option compiler="gcc" />
        <Build>
            <Target title="Release">
                <Option output="bin\Release\test_runner" prefix_auto="1" extension_auto="1" />
                <Option object_output="obj\Release\" />
                <Option type="1" />
                <Option compiler="gcc" />
                <Compiler>
                    <Add option="-std=c++17" />
                    <Add option="-O2" />
                    <Add option="-DUNIT_TEST" />
                    <Add directory="src" />
                    <Add directory="test" />
                    <Add directory=".pio\libdeps\native\Unity\src" />
                </Compiler>
                <Linker>
                    <Add option="-static" />
                    <Add option="-static-libgcc" />
                    <Add option="-static-libstdc++" />
                </Linker>
            </Target>
        </Build>
        <Compiler>
            <Add option="-std=c++17" />
            <Add option="-Wall" />
            <Add option="-DUNIT_TEST" />
            <Add directory="src" />
            <Add directory="test" />
            <Add directory=".pio\libdeps\native\Unity\src" />
        </Compiler>
        <Unit filename=".pio\libdeps\native\Unity\src\unity.c">
            <Option compilerVar="CC" />
        </Unit>
        <Unit filename="test\mock_sd.cpp" />
        <Unit filename="test\include_lib.cpp" />
        <Unit filename="test\test_sd_storage.cpp" />
        <Extensions>
            <envvars />
            <lib_finder disable_auto="1" />
        </Extensions>
    </Project>
</CodeBlocks_project_file>
