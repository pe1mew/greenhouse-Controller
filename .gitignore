.pio/
*.exe
*.dll

/hardware/pcb/gerbers
.claude/
/design/plantuml.jar

# Local secrets — never commit
.github/token.local
*.local

# Release artefacts — binaries + web-asset bundles must not enter git.
# Each tagged release directory (bin/<version>/) keeps its release-notes.md
# (the source-of-truth evidence trail), but the .bin / .elf / .zip / .map
# outputs are local-only — they are reproducible from the matching firmware/ +
# firmware/data/ checkout at the tagged commit via `bin/build_release.ps1`.
# Committing them bloats the repo without adding traceable value, and the
# .elf / .map files in particular can leak debug strings + symbol names.
bin/**/*.bin
bin/**/*.elf
bin/**/*.zip
bin/**/*.map

# Scratch dotfiles produced by curl-based acceptance scripts running out of
# the repo root (cookie jars, JSON request bodies, serial-capture logs).
# They live under bin/ for convenience; they're not source.
bin/.*

# 2.0.0-alpha.3.1 was a throwaway dev build that baked WiFi credentials
# (ssid + psk literals) into the source temporarily for one-shot NVS
# seeding on the bench LOLIN S3. The literals were stripped from source
# in alpha.3.2 but the .bin / .elf / .map produced by alpha.3.1 still
# contain the plaintext PSK and will leak it if uploaded anywhere. Keep
# the directory off GitHub. The changelog entry for alpha.3.1 carries
# the historical context; binaries belong nowhere but the original
# developer's disk.
/bin/2.0.0-alpha.3.1/

# Python caches
__pycache__/
*.py[cod]

# Editor / IDE state
.vscode/
.idea/

# Untracked working dumps (currently in Archive/) — phone-camera shots
# accidentally committed in b89fac0 totalled ~25 MB.  Block further drift:
/Archive/images/IMG_*.jpg
/Archive/images/IMG_*.JPG
/Archive/images/IMG_*.png
/finance/RECEIPT_*.pdf
/model/simulation.zip

# Generated PDF/HTML siblings of manual sources — produced by md2pdf.py
/manual/*.html
debug/
/.tmp

# Parsed siblings of SD logs — produced by log/logparser.py next to whatever
# log it decodes (parsed_<name>.txt). Pure derived output, reproducible from
# the .log + the parser at any commit; keeping them off git stops them
# cluttering `git status` every time a campaign log is analysed. No such file
# is tracked. The source .log/.csv files themselves are NOT ignored.
parsed_*.txt

# Bench test harness — operator decision 2026-07-23: test/ is local-only
# (pytest HIL harness with bench IPs/COM port/PIN defaults; runs only on the
# bench machine). NOTE: ~15 files under test/ were tracked BEFORE this rule
# (softwareTestPlan.md, testPlan.md, softwareTestResult.md, the 3_x/5_x
# manual-test records, test_10_rota.md) — gitignore does not untrack them;
# they stay in the repo and keep showing diffs until deliberately git
# rm --cached'd. New files under test/ are ignored from here on.
/test/

# ESP-IDF build-system artefacts (appearing from 2.0.0-alpha.1 onwards when
# framework = espidf replaces framework = arduino). PlatformIO+espidf still
# writes most of its build output under .pio/ (already ignored above), but
# native idf.py paths, managed-component caches, and per-env auto-generated
# sdkconfig files land outside it.
#
# Tracked: firmware/sdkconfig.defaults  (load-bearing project config, source-of-truth)
# Ignored: firmware/sdkconfig            (auto-generated, copy of defaults + diffs)
# Ignored: firmware/sdkconfig.old        (auto-generated backup)
# Ignored: firmware/sdkconfig.<env>      (auto-generated per-PlatformIO-environment)
/firmware/build/
/firmware/sdkconfig
/firmware/sdkconfig.old
/firmware/sdkconfig.lolin_s3
/firmware/sdkconfig.test_t2_relay
/firmware/managed_components/
/firmware/dependencies.lock
